{
  "name": "aura-mail",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron": "NODE_ENV=development electron .",
    "electron:build": "next build && electron-builder --mac --dir",
    "dist": "next build && electron-builder --mac"
  },
  "build": {
    "appId": "com.aura.mail",
    "productName": "Aura Mail",
    "directories": { "output": "dist-electron" },
    "files": [
      "electron/**/*",
      "!node_modules"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }],
      "darkModeSupport": true,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "Aura Mail",
      "backgroundColor": "#070b16"
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^14.13.0",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
